<!-- SVG Book Cover Default Image -->
<svg xmlns="http://www.w3.org/2000/svg" width="300" height="450" viewBox="0 0 300 450">
  <!-- Background -->
  <rect width="300" height="450" fill="#4B5563" />
  
  <!-- Book spine effect -->
  <rect x="0" y="0" width="30" height="450" fill="#374151" />
  
  <!-- Book title area -->
  <rect x="60" y="80" width="180" height="60" rx="5" fill="#1E40AF" />
  <text x="150" y="120" font-family="Arial, sans-serif" font-size="20" fill="white" text-anchor="middle">Book Title</text>
  
  <!-- Author area -->
  <text x="150" y="180" font-family="Arial, sans-serif" font-size="16" fill="white" text-anchor="middle">Author Name</text>
  
  <!-- Decorative elements -->
  <rect x="80" y="220" width="140" height="5" fill="#9CA3AF" />
  <rect x="80" y="240" width="140" height="5" fill="#9CA3AF" />
  <rect x="80" y="260" width="140" height="5" fill="#9CA3AF" />
  <rect x="80" y="280" width="140" height="5" fill="#9CA3AF" />
  
  <!-- "Book Cover" text at the bottom -->
  <text x="150" y="380" font-family="Arial, sans-serif" font-size="14" fill="white" text-anchor="middle">Motive Mentor</text>
  <text x="150" y="400" font-family="Arial, sans-serif" font-size="12" fill="white" text-anchor="middle">Bookstore</text>
</svg>
