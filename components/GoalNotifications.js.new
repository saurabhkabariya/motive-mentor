"use client";
import { useState, useEffect } from "react";
import { FaBell, FaExclamationTriangle, FaFire, FaCalendarAlt, FaTimes, FaCheck } from "react-icons/fa";
import { requestNotificationPermission, showBrowserNotification } from "@/app/utils/notifications";

export default function GoalNotifications({ userId, goals, streakData, darkMode, onDismissAll }) {
  const [notifications, setNotifications] = useState([]);
  const [showNotifications, setShowNotifications] = useState(false);
  const [unreadCount, setUnreadCount] = useState(0);
  const [notificationSettings, setNotificationSettings] = useState({
    browser: true,
    deadline: true,
    streak: true,
    progress: true,
    overdue: true
  });

  // Fetch user notification settings
  useEffect(() => {
    if (!userId) return;
    
    const fetchSettings = () => {
      // Try to get from localStorage
      const localSettings = localStorage.getItem(`notification_settings_${userId}`);
      
      if (localSettings) {
        try {
          setNotificationSettings(JSON.parse(localSettings));
        } catch (error) {
          console.error("Error parsing notification settings from localStorage:", error);
          // Save default settings to localStorage
          localStorage.setItem(`notification_settings_${userId}`, JSON.stringify(notificationSettings));
        }
      } else {
        // Save default settings to localStorage
        localStorage.setItem(`notification_settings_${userId}`, JSON.stringify(notificationSettings));
      }
    };
    
    fetchSettings();
  }, [userId]);

  // Calculate unread count
  useEffect(() => {
    if (notifications) {
      setUnreadCount(notifications.filter(n => !n.read).length);
    }
  }, [notifications]);

  // Generate and load notifications
  useEffect(() => {
    if (!userId || !goals) return;
    
    // Generate notifications based on goals and streak data
    const newNotifications = [];
    
    // Check for approaching deadlines (3 days or less)
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    goals.forEach(goal => {
      if (goal.completed) return;
      
      if (goal.deadline && notificationSettings.deadline) {
        const deadlineDate = new Date(goal.deadline);
        const daysDiff = Math.ceil((deadlineDate - today) / (1000 * 60 * 60 * 24));
        
        if (daysDiff <= 3 && daysDiff >= 0) {
          newNotifications.push({
            id: `deadline-${goal.id}`,
            type: 'deadline',
            title: 'Approaching Deadline',
            message: `"${goal.title}" is due in ${daysDiff === 0 ? 'today' : daysDiff === 1 ? 'tomorrow' : `${daysDiff} days`}!`,
            goalId: goal.id,
            createdAt: new Date().toISOString(),
            read: false
          });
        }
      }
      
      // Check for overdue goals
      if (goal.deadline && notificationSettings.overdue) {
        const deadlineDate = new Date(goal.deadline);
        if (deadlineDate < today) {
          newNotifications.push({
            id: `overdue-${goal.id}`,
            type: 'overdue',
            title: 'Overdue Goal',
            message: `"${goal.title}" is overdue! The deadline was ${deadlineDate.toLocaleDateString()}.`,
            goalId: goal.id,
            createdAt: new Date().toISOString(),
            read: false
          });
        }
      }
      
      // Check for goal progress
      if (notificationSettings.progress && goal.tasks && goal.tasks.length > 0) {
        const completedTasks = goal.tasks.filter(task => task.completed).length;
        const totalTasks = goal.tasks.length;
        
        if (completedTasks > 0 && completedTasks === totalTasks - 1) {
          newNotifications.push({
            id: `progress-${goal.id}`,
            type: 'progress',
            title: 'Almost There!',
            message: `You're one task away from completing "${goal.title}"!`,
            goalId: goal.id,
            createdAt: new Date().toISOString(),
            read: false
          });
        } else if (completedTasks > 0 && completedTasks / totalTasks === 0.5) {
          newNotifications.push({
            id: `progress-${goal.id}`,
            type: 'progress',
            title: 'Halfway There!',
            message: `You've completed half of the tasks for "${goal.title}"!`,
            goalId: goal.id,
            createdAt: new Date().toISOString(),
            read: false
          });
        }
      }
    });
    
    // Check for streak notifications
    if (notificationSettings.streak && streakData && streakData.currentStreak > 0) {
      if (streakData.currentStreak === 3 || streakData.currentStreak === 7 || 
          streakData.currentStreak === 14 || streakData.currentStreak === 30) {
        newNotifications.push({
          id: `streak-${streakData.currentStreak}`,
          type: 'streak',
          title: 'Streak Achievement',
          message: `You've maintained a streak for ${streakData.currentStreak} days!`,
          createdAt: new Date().toISOString(),
          read: false
        });
      }
    }
    
    // Fetch existing notifications from localStorage and merge with generated ones
    try {
      const storedNotifications = JSON.parse(localStorage.getItem(`notifications_${userId}`) || '[]');
      
      // Merge: keep existing notifications that don't have the same ID as new ones
      const existingNotificationIds = newNotifications.map(n => n.id);
      const filteredStoredNotifications = storedNotifications.filter(
        n => !existingNotificationIds.includes(n.id)
      );
      
      // Combine and sort by creation date (newest first)
      const combinedNotifications = [...filteredStoredNotifications, ...newNotifications]
        .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
      
      setNotifications(combinedNotifications);
      
      // Save new notifications to localStorage if there are any
      if (newNotifications.length > 0) {
        saveNotificationsToLocalStorage(userId, combinedNotifications);
        
        // Send browser notifications if enabled
        if (notificationSettings.browser && "Notification" in window) {
          if (Notification.permission === "granted") {
            newNotifications.forEach(notification => {
              showBrowserNotification(notification.title, notification.message, {
                onClick: () => {
                  markNotificationAsRead(notification.id);
                }
              });
            });
          }
        }
      }
    } catch (error) {
      console.error("Error processing notifications:", error);
    }
  }, [userId, goals, streakData, notificationSettings]);
  
  // Save notifications to localStorage
  const saveNotificationsToLocalStorage = (userId, notificationsToSave) => {
    try {
      localStorage.setItem(`notifications_${userId}`, JSON.stringify(notificationsToSave));
    } catch (error) {
      console.error("Error saving notifications to localStorage:", error);
    }
  };
  
  // Mark a notification as read
  const markNotificationAsRead = (notificationId) => {
    try {
      const updatedNotifications = notifications.map(notification => 
        notification.id === notificationId ? { ...notification, read: true } : notification
      );
      
      setNotifications(updatedNotifications);
      saveNotificationsToLocalStorage(userId, updatedNotifications);
    } catch (error) {
      console.error("Error marking notification as read:", error);
    }
  };
  
  // Delete a notification
  const deleteNotification = (notificationId) => {
    try {
      const updatedNotifications = notifications.filter(
        notification => notification.id !== notificationId
      );
      
      setNotifications(updatedNotifications);
      saveNotificationsToLocalStorage(userId, updatedNotifications);
    } catch (error) {
      console.error("Error deleting notification:", error);
    }
  };
  
  // Delete all notifications
  const deleteAllNotifications = () => {
    try {
      setNotifications([]);
      localStorage.setItem(`notifications_${userId}`, JSON.stringify([]));
      
      // Close the notifications panel
      setShowNotifications(false);
      
      // Callback to refresh goals if needed
      if (onDismissAll) {
        onDismissAll();
      }
    } catch (error) {
      console.error("Error deleting all notifications:", error);
    }
  };
  
  // Show notification panel
  const toggleNotifications = () => {
    // If we're opening the panel, mark all as read
    if (!showNotifications) {
      const updatedNotifications = notifications.map(notification => ({ ...notification, read: true }));
      setNotifications(updatedNotifications);
      saveNotificationsToLocalStorage(userId, updatedNotifications);
    }
    
    setShowNotifications(!showNotifications);
  };
  
  // Request notification permission
  const requestPermission = async () => {
    const permission = await requestNotificationPermission();
    if (permission === "granted") {
      const updatedSettings = { ...notificationSettings, browser: true };
      setNotificationSettings(updatedSettings);
      localStorage.setItem(`notification_settings_${userId}`, JSON.stringify(updatedSettings));
    }
  };
  
  // Helper to get icon by notification type
  const getNotificationIcon = (type) => {
    switch (type) {
      case 'deadline':
        return <FaCalendarAlt className="text-blue-500" />;
      case 'overdue':
        return <FaExclamationTriangle className="text-red-500" />;
      case 'streak':
        return <FaFire className="text-orange-500" />;
      case 'progress':
        return <FaCheck className="text-green-500" />;
      default:
        return <FaBell className="text-gray-500" />;
    }
  };
  
  return (
    <div className="relative">
      {/* Notification Bell Button */}
      <button 
        onClick={toggleNotifications}
        className="relative p-2 rounded-full hover:bg-gray-200 dark:hover:bg-gray-700 transition"
        aria-label="Notifications"
      >
        <FaBell className="text-xl" />
        {unreadCount > 0 && (
          <span className="absolute top-0 right-0 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">
            {unreadCount}
          </span>
        )}
      </button>
      
      {/* Notifications Panel */}
      {showNotifications && (
        <div className={`absolute right-0 mt-2 w-80 max-h-96 overflow-y-auto rounded-lg shadow-lg z-50 ${darkMode ? "bg-gray-800 text-white" : "bg-white text-gray-800"} border border-gray-300 dark:border-gray-600`}>
          <div className="flex justify-between items-center p-4 border-b border-gray-300 dark:border-gray-600">
            <h3 className="font-medium">Notifications</h3>
            {notifications.length > 0 && (
              <button 
                onClick={deleteAllNotifications}
                className="text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-300"
              >
                Clear All
              </button>
            )}
          </div>
          
          {notifications.length === 0 ? (
            <div className="p-4 text-center text-gray-500 dark:text-gray-400">
              No notifications
            </div>
          ) : (
            <div>
              {notifications.map(notification => (
                <div 
                  key={notification.id} 
                  className={`p-4 border-b border-gray-200 dark:border-gray-700 ${notification.read ? 'opacity-75' : ''}`}
                >
                  <div className="flex justify-between items-start">
                    <div className="flex items-start space-x-3">
                      <div className="mt-1">
                        {getNotificationIcon(notification.type)}
                      </div>
                      <div>
                        <div className="font-medium">{notification.title}</div>
                        <div className="text-sm text-gray-600 dark:text-gray-300">{notification.message}</div>
                        <div className="text-xs text-gray-500 dark:text-gray-400 mt-1">
                          {new Date(notification.createdAt).toLocaleString()}
                        </div>
                      </div>
                    </div>
                    <button 
                      onClick={() => deleteNotification(notification.id)}
                      className="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
                      aria-label="Delete notification"
                    >
                      <FaTimes />
                    </button>
                  </div>
                </div>
              ))}
            </div>
          )}
          
          {/* Permission Request */}
          {"Notification" in window && Notification.permission !== "granted" && (
            <div className="p-3 bg-blue-50 dark:bg-blue-900 text-sm">
              <p className="text-blue-800 dark:text-blue-200 mb-2">
                Enable browser notifications for better reminders.
              </p>
              <button 
                onClick={requestPermission}
                className="bg-blue-500 text-white px-3 py-1 rounded text-xs hover:bg-blue-600"
              >
                Enable Notifications
              </button>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
